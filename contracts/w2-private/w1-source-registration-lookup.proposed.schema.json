{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epick.dev/contracts/w2-private/w1-source-registration-lookup.proposed.schema.json",
  "title": "PROPOSED W1 source registration lookup response",
  "description": "W2 proposal only. W1 has not accepted or pinned this schema as its canonical contract.",
  "$comment": "canonical_url MUST pass w1.private.w2-source-registration-canonical-url.semantic-profile.v1. The W1 producer MUST emit execution_fence and owner_deletion_epoch as canonical unsigned decimal tokens under w1-w2.private.source-registration-json-integer-token.semantic-profile.v1. JSON Schema validation alone is insufficient for either semantic profile.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "w1.private.w2-source-registration-lookup.v1"
    },
    "status": {
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE"
      ]
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "execution_fence": {
      "type": "integer",
      "minimum": 1,
      "description": "Mathematical bound only; W1 producer bytes MUST also follow the separately pinned NORMATIVE integer-token profile."
    },
    "owner_deletion_epoch": {
      "type": "integer",
      "minimum": 0,
      "description": "Mathematical bound only; W1 producer bytes MUST also follow the separately pinned NORMATIVE integer-token profile."
    },
    "company_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_id": {
      "type": "string",
      "format": "uuid"
    },
    "canonical_url": {
      "type": "string",
      "minLength": 1,
      "description": "Structural HTTPS shape only. The value MUST also pass the separately pinned NORMATIVE canonical URL semantic profile; schema acceptance alone is insufficient.",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?:\\[[^\\]\\s/?#@]+\\]|[^\\s@:/?#]+)(?::[0-9]+)?(?:[/?#]|$)"
    },
    "w1_source_type": {
      "type": "string",
      "minLength": 1
    },
    "registration_input_version": {
      "type": "string",
      "minLength": 1
    },
    "company_official_domain": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "not": {
        "pattern": "(?:^\\s|\\s$)"
      }
    },
    "company_legal_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "not": {
        "pattern": "(?:^\\s|\\s$)"
      }
    },
    "company_legal_identifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\s:](?:[^:]*[^\\s:])?:\\S(?:[\\s\\S]*\\S)?$",
        "not": {
          "pattern": "(?:^\\s|\\s$)"
        }
      }
    },
    "company_identity_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
        "not": {
          "pattern": "(?:^\\s|\\s$)"
        }
      }
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "status",
    "command_id",
    "execution_fence",
    "owner_deletion_epoch",
    "company_id",
    "source_id"
  ],
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "AVAILABLE"
        }
      },
      "required": [
        "canonical_url",
        "w1_source_type",
        "registration_input_version",
        "company_official_domain",
        "company_legal_name",
        "company_legal_identifiers",
        "company_identity_evidence_refs"
      ],
      "not": {
        "required": [
          "reason_code"
        ]
      }
    },
    {
      "properties": {
        "status": {
          "const": "UNAVAILABLE"
        }
      },
      "required": [
        "reason_code"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "canonical_url"
            ]
          },
          {
            "required": [
              "w1_source_type"
            ]
          },
          {
            "required": [
              "registration_input_version"
            ]
          },
          {
            "required": [
              "company_official_domain"
            ]
          },
          {
            "required": [
              "company_legal_name"
            ]
          },
          {
            "required": [
              "company_legal_identifiers"
            ]
          },
          {
            "required": [
              "company_identity_evidence_refs"
            ]
          }
        ]
      }
    }
  ]
}
